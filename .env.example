# Copy to the ignored .env file; never commit tokens or real routing IDs.
# Docker Compose loads .env automatically. Native Python does not: export its variables.
# Configuration reference: docs/configuration.md; launch guide: docs/running.md
# No provider account or credentials are needed for the offline local checks.

# Native-only paths, used when exported into the shell; --config overrides SENTINEL_CONFIG.
SENTINEL_CONFIG=config/idle.toml
SENTINEL_STATE_DIR=data
# Docker path inside the image; independent of native paths above.
# Options: /app/config.toml (idle), /app/config/sites.example.toml,
# /app/config/telegram.example.toml; the fixture demo uses compose.monitoring.yaml.
# Website and Telegram configs share /app/config/checks.example.toml as their endpoint inventory.
# Select a main config above, not checks.example.toml; rebuild after inventory edits.
SENTINEL_CONTAINER_CONFIG=/app/config.toml
# Local Mailpit browser UI on 127.0.0.1; applies to the automatic local override only.
MAILPIT_HTTP_PORT=8025

# Supplying a token alone does not enable Telegram: select TOML with [telegram] enabled = true.
# Keep all fields empty for offline checks. Live Telegram uses: docker compose -f compose.yaml ...
# BotFather token; do not share it or include it in commands that you paste publicly.
SENTINEL_TELEGRAM_BOT_TOKEN=
# Numeric Bot API chat ID, not @username: private chat, group or channel.
# Channel alerts need bot administrator/post permission; channel posts cannot issue commands.
SENTINEL_TELEGRAM_CHAT_ID=
# Required when enabled, including channel-only alerts: up to 20 unique human user IDs, comma-separated.
# Commands work only in the configured private chat/group and for these users.
SENTINEL_TELEGRAM_ALLOWED_USER_IDS=
# Optional positive forum topic ID for a group; leave empty for a channel or the whole chat.
SENTINEL_TELEGRAM_TOPIC_ID=

# Incoming events: select compose.ingress.yaml, configure Telegram above and set this token.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Each source uses a distinct token; the example source is named app.
SENTINEL_SOURCE_APP_TOKEN=
