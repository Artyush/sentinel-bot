# No tokens, provider account, or recipients are needed for local checks.
# Native package settings, when exported into the shell:
SENTINEL_CONFIG=config/idle.toml
SENTINEL_STATE_DIR=data
# Docker image configuration, independent from the native file path:
SENTINEL_CONTAINER_CONFIG=/app/config.toml
MAILPIT_HTTP_PORT=8025

# Optional Telegram credentials; enabled only by [telegram] enabled = true in TOML.
# Keep empty for local checks. Live Telegram needs the base Compose file's network.
SENTINEL_TELEGRAM_BOT_TOKEN=
SENTINEL_TELEGRAM_CHAT_ID=
SENTINEL_TELEGRAM_ALLOWED_USER_IDS=
SENTINEL_TELEGRAM_TOPIC_ID=
